# ─────────────────────────────────────────────────────────────
# 마음토스 기관 전용 결제창 환경변수
# 이 파일을 복사해 .env.local 을 만들고 실제 값으로 채워주세요.
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# [클라이언트] 토스페이먼츠 클라이언트 키 (브라우저에 노출됨)
# 자동결제(빌링) 계약이 된 클라이언트 키여야 합니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=live_ck_xxxxxxxxxxxxxxxxxxxx

# [서버 전용] 토스페이먼츠 시크릿 키 (절대 외부 노출 금지)
# 위 클라이언트 키와 매칭되는 시크릿 키여야 합니다. (예: live_sk_..., test_sk_...)
TOSS_SECRET_KEY=live_sk_xxxxxxxxxxxxxxxxxxxx

# [서버 전용] 입장 코드 (기관에 전달하는 패스워드)
# 콤마(,)로 여러 개를 등록할 수도 있습니다. 예: CODE-A,CODE-B
# ⚠️ 실제 코드를 여기에 넣지 마세요. .env.local 에만 설정하세요.
ACCESS_CODE=your-access-code

# [서버 전용] 입장 세션 쿠키 서명 시크릿 (임의의 긴 무작위 문자열)
#   openssl rand -hex 32  로 생성 권장
SESSION_SECRET=change-me-to-a-long-random-string
